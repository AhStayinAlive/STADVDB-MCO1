{
  "name": "mco_model",
  "label": "MCO Data Warehouse Model",
  "description": "OLAP model for credit metrics data (quarterly)",
  "stores": {
    "default": {
      "type": "sql"
    }
  },
  "cubes": [
    {
      "name": "credit_metrics",
      "label": "Credit Metrics (Quarterly)",
      "fact": "fact_credit_metrics_qtr",
      "store": "default",

      "measures": [
        { "name": "originations_cnt" },
        { "name": "origination_amt" },
        { "name": "balance_amt" },
        { "name": "delinquent_cnt" },
        { "name": "delinquent_amt" },
        { "name": "chargeoff_cnt" },
        { "name": "chargeoff_amt" },
        { "name": "default_rate" },
        { "name": "prime_rate" }
      ],

      "aggregates": [
        { "name": "originations_cnt_sum", "measure": "originations_cnt", "function": "sum" },
        { "name": "origination_amt_sum", "measure": "origination_amt", "function": "sum" },
        { "name": "balance_amt_sum", "measure": "balance_amt", "function": "sum" },
        { "name": "delinquent_cnt_sum", "measure": "delinquent_cnt", "function": "sum" },
        { "name": "delinquent_amt_sum", "measure": "delinquent_amt", "function": "sum" },
        { "name": "chargeoff_cnt_sum", "measure": "chargeoff_cnt", "function": "sum" },
        { "name": "chargeoff_amt_sum", "measure": "chargeoff_amt", "function": "sum" },
        { "name": "default_rate_avg", "measure": "default_rate", "function": "avg" },
        { "name": "prime_rate_avg", "measure": "prime_rate", "function": "avg" }
      ],

      "joins": [
        { "master": "quarter_key",   "detail": "dim_date_qtr.quarter_key", "alias": "date_qtr" },
        { "master": "geo_key",       "detail": "dim_geo.geo_key",           "alias": "geo" },
        { "master": "product_key",   "detail": "dim_product.product_key",     "alias": "product" }
      ],

      "dimensions": ["date_qtr", "geo", "product"],

      "mappings": {
        "quarter_key": "quarter_key",
        "geo_key": "geo_key",
        "product_key": "product_key",
        "originations_cnt": "originations_cnt",
        "origination_amt": "origination_amt",
        "balance_amt": "balance_amt",
        "delinquent_cnt": "delinquent_cnt",
        "delinquent_amt": "delinquent_amt",
        "chargeoff_cnt": "chargeoff_cnt",
        "chargeoff_amt": "chargeoff_amt",
        "default_rate": "default_rate",
        "prime_rate": "prime_rate"
      }
    }
  ],

  "dimensions": [
    {
      "name": "date_qtr",
      "label": "Quarter",
      "levels": [
        {
          "name": "year",
          "label": "Year",
          "attributes": ["year"],
          "label_attribute": "year"
        },
        {
          "name": "quarter",
          "label": "Quarter",
          "attributes": ["quarter"],
          "label_attribute": "quarter"
        }
      ],
      "hierarchies": [
        { "name": "default", "levels": ["year", "quarter"] }
      ],
      "mappings": {
        "table": "dim_date_qtr",
        "key": "quarter_key",
        "attributes": {
          "quarter_key": "quarter_key",
          "year": "year",
          "quarter": "quarter",
          "quarter_start": "quarter_start",
          "quarter_end": "quarter_end"
        }
      }
    },

    {
      "name": "geo",
      "label": "Geography",
      "levels": [
        { "name": "country", "attributes": ["country"], "label_attribute": "country" },
        { "name": "state_province", "attributes": ["state_province"], "label_attribute": "state_province" },
        { "name": "city", "attributes": ["city"], "label_attribute": "city" }
      ],
      "hierarchies": [
        { "name": "default", "levels": ["country", "state_province", "city"] }
      ],
      "mappings": {
        "table": "dim_geo",
        "key": "geo_key",
        "attributes": {
          "geo_key": "geo_key",
          "country": "country",
          "state_province": "state_province",
          "city": "city"
        }
      }
    },

    {
      "name": "product",
      "label": "Product",
      "levels": [
        { "name": "product_code", "attributes": ["product_code"], "label_attribute": "product_code" },
        { "name": "segment", "attributes": ["segment"], "label_attribute": "segment" }
      ],
      "hierarchies": [
        { "name": "default", "levels": ["product_code", "segment"] }
      ],
      "mappings": {
        "table": "dim_product",
        "key": "product_key",
        "attributes": {
          "product_key": "product_key",
          "product_code": "product_code",
          "product_type": "product_type",
          "segment": "segment"
        }
      }
    }
  ]
}
