{
  "name": "mco_model",
  "label": "MCO Data Warehouse Model",
  "description": "OLAP model for credit metrics data (quarterly)",
  "stores": {
    "default": {
      "type": "sql"
    }
  },
  "cubes": [
    {
      "name": "credit_metrics",
      "label": "Credit Metrics (Quarterly)",
      "description": "Fact table for credit origination, balance, and default metrics by quarter.",
      "fact": "fact_credit_metrics_qtr",
      "store": "default",

      "measures": [
        { "name": "originations_cnt", "label": "Number of Originations", "aggregations": ["sum"] },
        { "name": "origination_amt", "label": "Origination Amount", "aggregations": ["sum"] },
        { "name": "balance_amt", "label": "Balance Amount", "aggregations": ["sum"] },
        { "name": "default_rate", "label": "Default Rate", "aggregations": ["avg"] },
        { "name": "prime_rate", "label": "Prime Rate", "aggregations": ["avg"] },
        { "name": "lending_rate", "label": "Lending Rate", "aggregations": ["avg"] }
      ],

      "aggregates": [
        { "name": "originations_cnt_sum", "function": "sum", "measure": "originations_cnt" },
        { "name": "origination_amt_sum", "function": "sum", "measure": "origination_amt" },
        { "name": "balance_amt_sum", "function": "sum", "measure": "balance_amt" },
        { "name": "default_rate_avg", "function": "avg", "measure": "default_rate" },
        { "name": "prime_rate_avg", "function": "avg", "measure": "prime_rate" },
        { "name": "lending_rate_avg", "function": "avg", "measure": "lending_rate" }
      ],

      "dimensions": ["date_qtr", "geo", "product"],

      "joins": [
        {
          "master": "quarter_key",
          "detail": "dim_date_qtr.quarter_key",
          "alias": "date_qtr"
        },
        {
          "master": "geo_key",
          "detail": "dim_geo.geo_key",
          "alias": "geo"
        },
        {
          "master": "product_key",
          "detail": "dim_product.product_key",
          "alias": "product"
        }
      ]
    }
  ],

  "dimensions": [
    {
      "name": "date_qtr",
      "label": "Quarter",
      "levels": [
        {
          "name": "year",
          "label": "Year",
          "attributes": ["year"],
          "label_attribute": "year"
        },
        {
          "name": "quarter",
          "label": "Quarter",
          "attributes": ["quarter"],
          "label_attribute": "quarter"
        }
      ],
      "hierarchies": [
        { "name": "default", "levels": ["year", "quarter"] }
      ],
      "mappings": {
        "table": "dim_date_qtr",
        "key": "quarter_key",
        "attributes": {
          "quarter_key": "quarter_key",
          "year": "year",
          "quarter": "quarter",
          "quarter_start": "quarter_start",
          "quarter_end": "quarter_end"
        }
      }
    },
    {
      "name": "geo",
      "label": "Geography",
      "levels": [
        {
          "name": "country",
          "label": "Country",
          "attributes": ["country"],
          "label_attribute": "country"
        },
        {
          "name": "state_province",
          "label": "State/Province",
          "attributes": ["state_province"],
          "label_attribute": "state_province"
        },
        {
          "name": "city",
          "label": "City",
          "attributes": ["city"],
          "label_attribute": "city"
        }
      ],
      "hierarchies": [
        { "name": "default", "levels": ["country", "state_province", "city"] }
      ],
      "mappings": {
        "table": "dim_geo",
        "key": "geo_key",
        "attributes": {
          "geo_key": "geo_key",
          "country": "country",
          "state_province": "state_province",
          "city": "city"
        }
      }
    },
    {
      "name": "product",
      "label": "Product",
      "levels": [
        {
          "name": "product_code",
          "label": "Product Code",
          "attributes": ["product_code"],
          "label_attribute": "product_code"
        },
        {
          "name": "segment",
          "label": "Segment",
          "attributes": ["segment"],
          "label_attribute": "segment"
        }
      ],
      "hierarchies": [
        { "name": "default", "levels": ["product_code", "segment"] }
      ],
      "mappings": {
        "table": "dim_product",
        "key": "product_key",
        "attributes": {
          "product_key": "product_key",
          "product_code": "product_code",
          "product_type": "product_type",
          "segment": "segment"
        }
      }
    }
  ]
}
